+    // KioCG start - large fruit
+    private boolean growMedium(final ServerLevel level, final BlockPos pos, final RandomSource random, final Direction direction, final BlockState fruit) {
+        return this.growCube(level, pos, random, direction, fruit, StemBlock.MEDIUM_OFFSETS, random.nextBoolean());
+    }
+
+    private boolean growLarge(final ServerLevel level, final BlockPos pos, final RandomSource random, final Direction direction, final BlockState fruit) {
+        return this.growCube(level, pos, random, direction, fruit, StemBlock.LARGE_OFFSETS, false);
+    }
+
+    private boolean growCube(final ServerLevel level, final BlockPos pos, final RandomSource random, final Direction direction, final BlockState fruit, final java.util.Map<Direction, Iterable<BlockPos>> growMap, final boolean mirror) {
+        Iterable<BlockPos> offsets = growMap.get(direction);
+        boolean lateralIsX = (direction == Direction.NORTH || direction == Direction.SOUTH);
+
+        java.util.List<BlockPos> targets = new java.util.ArrayList<>();
+        for (BlockPos offset : offsets) {
+            int dx = offset.getX();
+            int dy = offset.getY();
+            int dz = offset.getZ();
+
+            if (dx == 0 && dy == 0 && dz == 0) continue;
+
+            if (mirror) {
+                if (lateralIsX) dx = -dx;
+                else dz = -dz;
+            }
+
+            BlockPos dPos = pos.offset(dx, dy, dz);
+            if (!level.getBlockState(dPos).isAir() || (dy == 0 && !level.getBlockState(dPos.below()).is(this.fruitSupportBlocks))) {
+                return false;
+            }
+            targets.add(dPos);
+        }
+
+        targets.forEach(target -> org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockGrowEvent(level, target, fruit, Block.UPDATE_ALL));
+        return true;
+    }
