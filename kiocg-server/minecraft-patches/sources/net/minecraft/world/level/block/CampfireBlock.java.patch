+    // KioCG start - change container behavior
+    @Override
+    protected InteractionResult useWithoutItem(
+            final BlockState state,
+            final Level level,
+            final BlockPos pos,
+            final Player player,
+            final BlockHitResult hitResult
+    ) {
+        if (level.getBlockEntity(pos) instanceof CampfireBlockEntity campfire) {
+            int clickSlot = getClickSlot(state, pos, hitResult.getLocation());
+            ItemStack stack = campfire.getItems().get(clickSlot);
+            if (stack.isEmpty()) {
+                return InteractionResult.PASS;
+            }
+
+            if (!player.addItem(stack)) {
+                player.drop(stack, false);
+            }
+            campfire.getItems().set(clickSlot, ItemStack.EMPTY);
+
+            level.gameEvent(GameEvent.BLOCK_CHANGE, pos, GameEvent.Context.of(player, state));
+            campfire.setChanged();
+            level.sendBlockUpdated(pos, state, state, Block.UPDATE_ALL);
+            player.awardStat(Stats.INTERACT_WITH_CAMPFIRE);
+            return InteractionResult.SUCCESS_SERVER;
+        }
+
+        return InteractionResult.PASS;
+    }
+
+    private static int getClickSlot(final BlockState state, final BlockPos pos, final net.minecraft.world.phys.Vec3 hitLocation) {
+        final int[] slotByQuadrant = switch (state.getValue(FACING)) {
+            case NORTH -> new int[]{2, 3, 1, 0};
+            case EAST -> new int[]{1, 2, 0, 3};
+            case SOUTH -> new int[]{0, 1, 3, 2};
+            case WEST -> new int[]{3, 0, 2, 1};
+            default -> throw new IllegalStateException("Unexpected campfire facing: " + state.getValue(FACING));
+        };
+
+        final double localX = hitLocation.x - pos.getX();
+        final double localZ = hitLocation.z - pos.getZ();
+        final int quadrant = (localX > 0.5 ? 1 : 0) | (localZ > 0.5 ? 2 : 0);
+        return slotByQuadrant[quadrant];
+    }
+    // KioCG end - change container behavior
 
