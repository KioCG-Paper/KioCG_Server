+    private void createSpellEntity(final double x, final double y, final double z) {
+        BlockPos pos = BlockPos.containing(x, y, z);
+        BlockState blockState = this.level().getBlockState(pos);
+        if (blockState.isCollisionShapeFullBlock(this.level(), pos)) {
+            return;
+        }
+
+        for (int i = 0; i <= 4; i++) {
+            BlockPos below = pos.below();
+            BlockState belowState = this.level().getBlockState(below);
+            if (!belowState.isCollisionShapeFullBlock(this.level(), below)) {
+                pos = below;
+                continue;
+            }
+
+            if (belowState.isFaceSturdy(this.level(), below, Direction.UP) && this.level().getRawBrightness(pos, 0) <= 0) {
+                net.minecraft.world.entity.projectile.EvokerFangs evokerFangs = new net.minecraft.world.entity.projectile.EvokerFangs(EntityType.EVOKER_FANGS, this.level());
+                evokerFangs.setYRot(this.random.nextFloat() * 360.0F);
+                evokerFangs.setPos(x, pos.getY(), z);
+                this.level().addFreshEntity(evokerFangs);
+            }
+            return;
+        }
+    }
