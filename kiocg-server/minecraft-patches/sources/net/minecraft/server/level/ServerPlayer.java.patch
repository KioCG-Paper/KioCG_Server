+    private long refreshNearbyChunkLoad() {
+        int x = SectionPos.blockToSectionCoord(this.getBlockX());
+        int z = SectionPos.blockToSectionCoord(this.getBlockZ());
+        net.minecraft.world.level.Level level = this.level();
+        long total = 0L;
+        for (int i = x - 4; i <= x + 4; ++i) {
+            for (int j = z - 4; j <= z + 4; ++j) {
+                net.minecraft.world.level.chunk.LevelChunk chunk = level.getChunkIfLoaded(i, j);
+                if (chunk != null) {
+                    total += chunk.getChunkLoad().getAverage();
+                }
+            }
+        }
+        return total;
+    }
+    // KioCG end - chunk load
 
