+    private void createSpellEntity(final double x, final double y, final double z) {
+        BlockPos pos = BlockPos.containing(x, y, z);
+        BlockState blockState = this.level().getBlockState(pos);
+        if (blockState.isCollisionShapeFullBlock(this.level(), pos)) {
+            return;
+        }
+
+        for (int i = 0; i <= 4; i++) {
+            BlockPos below = pos.below();
+            BlockState belowState = this.level().getBlockState(below);
+            if (!belowState.isCollisionShapeFullBlock(this.level(), below)) {
+                pos = below;
+                continue;
+            }
+
